# =============================================================================
# Agentic AI Support & Knowledge Research System - configuration
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every value below has a safe default: with an empty .env the system boots in
# fully offline deterministic mode and the whole test suite passes.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                  # development | staging | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                   # console | json   (use json in production)

# ---------------------------------------------------------------------------
# LLM provider
#   auto  -> use OpenAI if OPENAI_API_KEY is set, else deterministic offline
#   openai | azure_openai | deterministic  -> force a specific provider
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_BASE_URL=                     # optional: proxy / gateway override

# Model IDs are configuration, never hard-coded in application code.
# Verify current IDs at https://developers.openai.com/api/docs/models
LLM_SYNTHESIS_MODEL=gpt-5.6-sol      # grounded answer generation (quality-weighted)
LLM_CLASSIFICATION_MODEL=gpt-5.6-terra  # ticket classification / grading (cost-weighted)
LLM_TEMPERATURE=0.0                  # deterministic-by-default for a support system
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Azure OpenAI (only used when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=               # https://<resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_SYNTHESIS_DEPLOYMENT=
AZURE_OPENAI_CLASSIFICATION_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Embeddings
#   auto -> OpenAI when a key is present, else deterministic hashing embeddings
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=auto              # auto | openai | azure_openai | hashing
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536            # text-embedding-3-large natively 3072; shortened via API
EMBEDDING_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# Vector store / database
#   auto -> pgvector when DATABASE_URL is set AND psycopg is installed, else sqlite
# ---------------------------------------------------------------------------
VECTOR_STORE=auto                    # auto | pgvector | sqlite

# PostgreSQL + pgvector (production target). Install extras: uv sync --extra postgres
DATABASE_URL=                        # postgresql://user:pass@localhost:5432/support_agent
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
PGVECTOR_HNSW_EF_SEARCH=100

# SQLite fallback (development / CI / no-Docker environments)
SQLITE_PATH=./data/support_agent.db

# ---------------------------------------------------------------------------
# Web research
#   auto -> Tavily when TAVILY_API_KEY is set AND tavily-python installed,
#           else the offline fixture provider
# ---------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=auto             # auto | tavily | fixture | none
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_DEPTH=advanced            # basic | advanced
WEB_SEARCH_TIMEOUT_SECONDS=30
# strict  -> hard-restrict results to the vendor's official domains (Tavily "filter")
# prefer  -> strongly rank official domains first but allow others (Tavily "boost")
WEB_SEARCH_DOMAIN_MODE=strict

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.15
RETRIEVAL_HYBRID_ALPHA=0.65          # 1.0 = pure vector, 0.0 = pure keyword
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# ---------------------------------------------------------------------------
# Agent execution budgets (guardrails against runaway loops)
# ---------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=4               # retrieve -> grade -> refine cycles
AGENT_MAX_TOOL_CALLS=12
AGENT_TOOL_TIMEOUT_SECONDS=45
AGENT_TOTAL_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------
CLASSIFICATION_CONFIDENCE_FLOOR=0.55 # below this a ticket goes to human triage
ENABLE_INJECTION_SCANNING=true
ENABLE_CITATION_VALIDATION=true
REQUIRE_APPROVAL_FOR_HIGH_RISK=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
TRACING_PROVIDER=none                # none | langsmith | otel
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-support-system
OTEL_EXPORTER_OTLP_ENDPOINT=
REDACT_PII_IN_LOGS=true

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*
